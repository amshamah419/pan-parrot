# Copy to .env for local `npm run dev` / `npm start`. Never commit the copy.
# On Netlify, set the production values in Site configuration → Environment variables.
# Do not set DATABASE_URL or AUTH_DEV_EXPOSE_CODE on Netlify.

# openssl rand -base64 32
SESSION_SECRET=

# Comma-separated. These addresses become admins the next time they sign in.
ADMIN_EMAILS=ashamah@paloaltonetworks.com

# Public origin of this site, no trailing slash. Netlify also provides URL.
SITE_URL=http://localhost:8080

# Resend (https://resend.com). Required in production so sign-in codes can be delivered.
RESEND_API_KEY=
EMAIL_FROM="PAN Parrot <noreply@your-domain>"

# Retention. Captures older than this many days are deleted, and each endpoint
# keeps at most this many requests.
REQUEST_RETENTION_DAYS=14
MAX_REQUESTS_PER_ENDPOINT=200
MAX_BODY_BYTES=262144

# Local Postgres only. Leave unset on Netlify — the Netlify Database adapter
# uses NETLIFY_DB_URL, which the platform injects. Apply migrations locally with
# npm run db:migrate:local. Hosted migrations run on deploy.
# DATABASE_URL=postgresql://localhost:5432/panparrot

# Local only. When true, POST /api/auth/request includes the code in the JSON
# response and does not send email. Ignored when NODE_ENV=production.
# AUTH_DEV_EXPOSE_CODE=true
