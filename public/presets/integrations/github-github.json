{
  "id": "github-github",
  "name": "GitHub",
  "pack": "GitHub",
  "vendor": "GitHub",
  "fidelity": "verified",
  "curated": true,
  "summary": "GET /repos/{owner}/{repo}/issues returns the issue array the XSOAR client requests.",
  "notes": [
    "The XSOAR client calls /repos/{owner}/{repo}/issues. This mock returns a JSON array of issues with number, title, state, and created_at.",
    "GitHub pages with a Link header. This mock uses limit and page query parameters instead of that header.",
    "Authorization is not required. Fine-grained permission errors are not simulated."
  ],
  "attribution": "Checked against the vendor's public API reference. Sample field names also follow demisto/content (MIT). See /presets/ATTRIBUTION.md.",
  "sourceUrl": "https://github.com/demisto/content/tree/master/Packs/GitHub/Integrations/GitHub",
  "spec": {
    "version": 1,
    "source": {
      "kind": "preset",
      "id": "github-github",
      "name": "GitHub",
      "fidelity": "verified",
      "attribution": "Vendor public API reference plus demisto/content (MIT).",
      "sourceUrl": "https://docs.github.com/en/rest/issues/issues#list-repository-issues",
      "notes": [],
      "verification": {
        "status": "verified",
        "docUrl": "https://docs.github.com/en/rest/issues/issues#list-repository-issues",
        "checkedAt": "2026-11-09",
        "differences": [
          "The XSOAR client calls /repos/{owner}/{repo}/issues. This mock returns a JSON array of issues with number, title, state, and created_at.",
          "GitHub pages with a Link header. This mock uses limit and page query parameters instead of that header.",
          "Authorization is not required. Fine-grained permission errors are not simulated."
        ]
      }
    },
    "operations": [
      {
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "page",
          "limitParam": "per_page",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 30,
          "maxLimit": 100
        },
        "id": "list-issues",
        "method": "GET",
        "pathTemplate": "/repos/{owner}/{repo}/issues",
        "summary": "List repository issues",
        "status": 200,
        "list": true,
        "envelope": {
          "type": "array"
        },
        "record": {
          "name": "issue",
          "kind": "object",
          "children": [
            {
              "name": "id",
              "kind": "integer"
            },
            {
              "name": "number",
              "kind": "integer"
            },
            {
              "name": "title",
              "kind": "string",
              "example": "Investigate failed logins"
            },
            {
              "name": "state",
              "kind": "enum",
              "enumValues": [
                "open",
                "closed"
              ]
            },
            {
              "name": "html_url",
              "kind": "string",
              "example": "https://github.com/example/repo/issues/1"
            },
            {
              "name": "created_at",
              "kind": "timestamp",
              "format": "iso"
            },
            {
              "name": "updated_at",
              "kind": "timestamp",
              "format": "iso"
            },
            {
              "name": "user",
              "kind": "object",
              "children": [
                {
                  "name": "login",
                  "kind": "string",
                  "example": "octocat"
                }
              ]
            }
          ]
        }
      }
    ],
    "chaos": {
      "enabled": false,
      "seed": "github-github",
      "mode": "probability",
      "probability": 0.25,
      "everyNth": 5,
      "duplicateRecords": false,
      "missingFields": false,
      "mixedTimestamps": false,
      "outOfOrder": false,
      "wrongTypes": false,
      "truncatedJson": false,
      "slowDrip": false,
      "partial": false,
      "malformedJson": false,
      "wrongContentType": false,
      "randomErrors": false,
      "latency": false,
      "paginationGlitch": "none",
      "malformedXml": false,
      "wrongNamespace": false,
      "soapFault": false,
      "authExpired": false,
      "authDenied": false,
      "authTokenFailure": false,
      "authClockSkew": false
    },
    "totalRecords": 500,
    "auth": {
      "mode": "none"
    }
  }
}
