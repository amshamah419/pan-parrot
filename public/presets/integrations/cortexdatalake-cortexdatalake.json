{
  "id": "cortexdatalake-cortexdatalake",
  "name": "Strata Logging Service XSOAR Connector",
  "pack": "CortexDataLake",
  "vendor": "Palo Alto Networks",
  "fidelity": "verified",
  "curated": true,
  "summary": "POST /query/v2/jobs returns a job id. The results route returns page.result.data.",
  "notes": [
    "The pack calls pan-cortex-data-lake create_query, which posts to /query/v2/jobs and then reads page.result.data from the job results. Those two routes are mocked.",
    "Job state polling is skipped: the results route returns rows immediately. valuesDictionary rows are shortened traffic fields.",
    "The regional hostname and the bearer token are not checked."
  ],
  "attribution": "Checked against the vendor's public API reference. Sample field names also follow demisto/content (MIT). See /presets/ATTRIBUTION.md.",
  "sourceUrl": "https://github.com/demisto/content/tree/master/Packs/CortexDataLake/Integrations/CortexDataLake",
  "spec": {
    "version": 1,
    "source": {
      "kind": "preset",
      "id": "cortexdatalake-cortexdatalake",
      "name": "Strata Logging Service XSOAR Connector",
      "fidelity": "verified",
      "attribution": "Vendor public API reference plus demisto/content (MIT).",
      "sourceUrl": "https://docs.paloaltonetworks.com/strata-logging-service/activation-and-onboarding/strata-logging-service-query-reference",
      "notes": [],
      "verification": {
        "status": "verified",
        "docUrl": "https://docs.paloaltonetworks.com/strata-logging-service/activation-and-onboarding/strata-logging-service-query-reference",
        "checkedAt": "2026-11-09",
        "differences": [
          "The pack calls pan-cortex-data-lake create_query, which posts to /query/v2/jobs and then reads page.result.data from the job results. Those two routes are mocked.",
          "Job state polling is skipped: the results route returns rows immediately. valuesDictionary rows are shortened traffic fields.",
          "The regional hostname and the bearer token are not checked."
        ]
      }
    },
    "operations": [
      {
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "none",
          "limitParam": "limit",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 1,
          "maxLimit": 1
        },
        "id": "create-query",
        "method": "POST",
        "pathTemplate": "/query/v2/jobs",
        "summary": "Create a logging query job",
        "status": 200,
        "list": false,
        "envelope": {
          "type": "object"
        },
        "record": {
          "name": "job",
          "kind": "object",
          "children": [
            {
              "name": "jobId",
              "kind": "id"
            },
            {
              "name": "state",
              "kind": "const",
              "constValue": "DONE"
            }
          ]
        }
      },
      {
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "page",
          "limitParam": "page_size",
          "offsetParam": "offset",
          "pageParam": "page_number",
          "cursorParam": "cursor",
          "defaultLimit": 50,
          "maxLimit": 100
        },
        "id": "query-results",
        "method": "GET",
        "pathTemplate": "/query/v2/jobs/{job_id}/results",
        "summary": "Read query job results",
        "status": 200,
        "list": false,
        "envelope": {
          "type": "object"
        },
        "record": {
          "name": "body",
          "kind": "object",
          "children": [
            {
              "name": "page",
              "kind": "object",
              "children": [
                {
                  "name": "result",
                  "kind": "object",
                  "children": [
                    {
                      "name": "data",
                      "kind": "array",
                      "pageItems": true,
                      "item": {
                        "name": "row",
                        "kind": "object",
                        "children": [
                          {
                            "name": "source_ip",
                            "kind": "ip"
                          },
                          {
                            "name": "dest_ip",
                            "kind": "ip"
                          },
                          {
                            "name": "action",
                            "kind": "enum",
                            "enumValues": [
                              "allow",
                              "deny",
                              "drop"
                            ]
                          },
                          {
                            "name": "time_generated",
                            "kind": "timestamp",
                            "format": "unix-ms"
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ],
    "chaos": {
      "enabled": false,
      "seed": "cortexdatalake-cortexdatalake",
      "mode": "probability",
      "probability": 0.25,
      "everyNth": 5,
      "duplicateRecords": false,
      "missingFields": false,
      "mixedTimestamps": false,
      "outOfOrder": false,
      "wrongTypes": false,
      "truncatedJson": false,
      "slowDrip": false,
      "partial": false,
      "malformedJson": false,
      "wrongContentType": false,
      "randomErrors": false,
      "latency": false,
      "paginationGlitch": "none",
      "malformedXml": false,
      "wrongNamespace": false,
      "soapFault": false,
      "authExpired": false,
      "authDenied": false,
      "authTokenFailure": false,
      "authClockSkew": false
    },
    "totalRecords": 500,
    "auth": {
      "mode": "none"
    }
  }
}
