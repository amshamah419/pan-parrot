    "operations": [
      {
        "id": "create",
        "method": "POST",
        "pathTemplate": "/services/search/jobs",
        "summary": "Create a search job",
        "status": 200,
        "list": false,
        "envelope": {
          "type": "object"
        },
        "record": {
          "name": "job",
          "kind": "object",
          "children": [
            {
              "name": "sid",
              "kind": "id"
            }
          ]
        },
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "none",
          "limitParam": "limit",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 20,
          "maxLimit": 500
        }
      },
      {
        "id": "results",
        "method": "GET",
        "pathTemplate": "/services/search/jobs/{sid}/results",
        "summary": "Read search results",
        "status": 200,
        "list": false,
        "envelope": {
          "type": "object"
        },
        "record": {
          "name": "body",
          "kind": "object",
          "children": [
            {
              "name": "results",
              "kind": "array",
              "minItems": 1,
              "maxItems": 1,
              "item": {
                "name": "row",
                "kind": "object",
                "children": [
                  {
                    "name": "_time",
                    "kind": "timestamp",
                    "format": "iso"
                  },
                  {
                    "name": "host",
                    "kind": "string",
                    "example": "search-head"
                  },
                  {
                    "name": "_raw",
                    "kind": "string",
                    "example": "user=ada action=login"
                  }
                ]
              }
            }
          ]
        },
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "none",
          "limitParam": "limit",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 20,
          "maxLimit": 500
        }
      }
    ],
    "chaos": {
      "enabled": false,
      "seed": "splunkpy-splunkpyv2",
      "mode": "probability",
      "probability": 0.25,
      "everyNth": 5,
      "duplicateRecords": false,
      "missingFields": false,
