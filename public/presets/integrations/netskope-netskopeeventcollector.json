              "kind": "string",
              "example": "test.update.microsoft.com"
            },
            {
              "name": "dstip",
              "kind": "ip"
            },
            {
              "name": "access_method",
              "kind": "const",
              "constValue": "Client"
            },
            {
              "name": "category",
              "kind": "string",
              "example": "Business"
            }
          ]
        },
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "offset",
          "limitParam": "limit",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 20,
