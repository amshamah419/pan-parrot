  "fidelity": "guessed",
  "curated": true,
  "summary": "Analysis query. response.results is the vulnerability page.",
  "notes": [
    "Cross-check: path: POST /rest/analysis is not a client call. Closest: /{url}/token (0)."
  ],
  "attribution": "Checked against a public vendor reference or, when that page is blocked, the integration test fixture plus the public client. See /presets/ATTRIBUTION.md.",
  "sourceUrl": "https://github.com/demisto/content/tree/master/Packs/Tenable_sc/Integrations/Tenable_sc",
  "spec": {
    "version": 1,
    "source": {
      "kind": "preset",
      "id": "tenable-sc-tenable-sc",
      "name": "Tenable.sc",
      "fidelity": "guessed",
      "attribution": "Public API reference or demisto/content test fixture (MIT).",
      "sourceUrl": "https://docs.tenable.com/tenablesc/api/Analysis.htm",
      "notes": [
        "Cross-check: path: POST /rest/analysis is not a client call. Closest: /{url}/token (0)."
      ]
    },
    "operations": [
      {
        "id": "analysis",
        "method": "POST",
        "pathTemplate": "/rest/analysis",
        "summary": "Run an analysis query",
        "status": 200,
        "list": true,
        "envelope": {
          "type": "wrapped",
          "arrayKey": "results"
        },
        "record": {
          "name": "vuln",
          "kind": "object",
          "children": [
            {
              "name": "pluginID",
              "kind": "id"
            },
            {
              "name": "severity",
              "kind": "enum",
              "enumValues": [
                "0",
                "1",
                "2",
                "3",
                "4"
              ]
            },
            {
              "name": "ip",
              "kind": "ip"
            },
            {
              "name": "dnsName",
              "kind": "string",
              "example": "lab-host.example.com"
            },
            {
              "name": "pluginName",
              "kind": "string",
              "example": "SSL Certificate Expiry"
            }
          ]
        },
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "offset",
          "limitParam": "endOffset",
          "offsetParam": "startOffset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 20,
          "maxLimit": 500
        }
      }
    ],
    "chaos": {
      "enabled": false,
      "seed": "tenable-sc-tenable-sc",
      "mode": "probability",
      "probability": 0.25,
      "everyNth": 5,
      "duplicateRecords": false,
      "missingFields": false,
      "mixedTimestamps": false,
      "outOfOrder": false,
      "wrongTypes": false,
      "truncatedJson": false,
      "slowDrip": false,
      "partial": false,
      "malformedJson": false,
      "wrongContentType": false,
      "randomErrors": false,
      "latency": false,
      "paginationGlitch": "none",
      "malformedXml": false,
      "wrongNamespace": false,
      "soapFault": false,
      "authExpired": false,
      "authDenied": false,
      "authTokenFailure": false,
      "authClockSkew": false,
      "graphqlErrors": false
    },
    "totalRecords": 200,
    "auth": {
      "mode": "api-key",
      "apiKey": {
        "in": "header",
        "name": "x-apikey",
        "value": "dummy-key"
      }
    }
  }
}
