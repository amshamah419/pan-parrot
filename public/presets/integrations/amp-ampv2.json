      "id": "amp-ampv2",
      "name": "Cisco AMP v2",
      "fidelity": "guessed",
      "attribution": "Public API reference or demisto/content test fixture (MIT).",
      "sourceUrl": "https://developer.cisco.com/docs/secure-endpoint/v1-api-reference-events/",
