    "operations": [
      {
        "id": "list-events",
        "method": "GET",
        "pathTemplate": "/v1/events",
        "summary": "List events",
        "status": 200,
        "list": true,
        "envelope": {
          "type": "wrapped",
          "arrayKey": "data"
        },
        "record": {
          "name": "event",
          "kind": "object",
          "children": [
            {
              "name": "id",
              "kind": "integer"
            },
            {
              "name": "timestamp",
              "kind": "timestamp"
            },
            {
              "name": "event_type",
              "kind": "string",
              "example": "Threat Detected"
            },
            {
              "name": "severity",
              "kind": "enum",
              "enumValues": [
                "Low",
                "Medium",
                "High"
              ]
            },
            {
              "name": "computer",
              "kind": "object",
              "children": [
                {
                  "name": "connector_guid",
                  "kind": "uuid"
                },
                {
                  "name": "hostname",
                  "kind": "string",
                  "example": "lab-host"
                }
              ]
            }
          ]
        },
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "offset",
          "limitParam": "limit",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 20,
          "maxLimit": 500
        }
      }
    ],
    "chaos": {
      "enabled": false,
      "seed": "amp-ampv2",
      "mode": "probability",
      "probability": 0.25,
      "everyNth": 5,
      "duplicateRecords": false,
