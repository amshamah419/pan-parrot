{
  "id": "prismacloud-prismacloudv2",
  "name": "Prisma Cloud v2",
  "pack": "PrismaCloud",
  "vendor": "Palo Alto Networks",
  "fidelity": "verified",
  "curated": true,
  "summary": "POST /login returns a token. POST /v2/alert returns the alert page.",
  "notes": [
    "POST /login returns { token }. The real token lasts about 10 minutes. This one is a fixed dummy and is not checked on later calls.",
    "POST /v2/alert returns { items, nextPageToken }. Alert resource objects are shortened to id, status, policy name, and time.",
    "Access keys and code-issue routes are not modeled."
  ],
  "attribution": "Checked against the vendor's public API reference. Sample field names also follow demisto/content (MIT). See /presets/ATTRIBUTION.md.",
  "sourceUrl": "https://github.com/demisto/content/tree/master/Packs/PrismaCloud/Integrations/PrismaCloudV2",
  "spec": {
    "version": 1,
    "source": {
      "kind": "preset",
      "id": "prismacloud-prismacloudv2",
      "name": "Prisma Cloud v2",
      "fidelity": "verified",
      "attribution": "Vendor public API reference plus demisto/content (MIT).",
      "sourceUrl": "https://pan.dev/prisma-cloud/api/cspm/alerts/",
      "notes": [],
      "verification": {
        "status": "verified",
        "docUrl": "https://pan.dev/prisma-cloud/api/cspm/alerts/",
        "checkedAt": "2026-11-09",
        "differences": [
          "POST /login returns { token }. The real token lasts about 10 minutes. This one is a fixed dummy and is not checked on later calls.",
          "POST /v2/alert returns { items, nextPageToken }. Alert resource objects are shortened to id, status, policy name, and time.",
          "Access keys and code-issue routes are not modeled."
        ]
      }
    },
    "operations": [
      {
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "none",
          "limitParam": "limit",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 1,
          "maxLimit": 1
        },
        "id": "login",
        "method": "POST",
        "pathTemplate": "/login",
        "summary": "Log in",
        "status": 200,
        "list": false,
        "envelope": {
          "type": "object"
        },
        "record": {
          "name": "session",
          "kind": "object",
          "children": [
            {
              "name": "token",
              "kind": "const",
              "constValue": "dummy-prisma-token"
            },
            {
              "name": "message",
              "kind": "const",
              "constValue": "login successful"
            }
          ]
        }
      },
      {
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "cursor",
          "limitParam": "limit",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "pageToken",
          "defaultLimit": 50,
          "maxLimit": 100
        },
        "id": "search-alerts",
        "method": "POST",
        "pathTemplate": "/v2/alert",
        "summary": "Search alerts",
        "status": 200,
        "list": true,
        "envelope": {
          "type": "token-page",
          "arrayKey": "items",
          "tokenKey": "nextPageToken"
        },
        "record": {
          "name": "alert",
          "kind": "object",
          "children": [
            {
              "name": "id",
              "kind": "id"
            },
            {
              "name": "status",
              "kind": "enum",
              "enumValues": [
                "open",
                "dismissed",
                "resolved"
              ]
            },
            {
              "name": "reason",
              "kind": "string",
              "example": "RESOURCE_ANOMALY"
            },
            {
              "name": "policy",
              "kind": "object",
              "children": [
                {
                  "name": "name",
                  "kind": "string",
                  "example": "Public storage bucket"
                }
              ]
            },
            {
              "name": "alertTime",
              "kind": "timestamp",
              "format": "unix-ms"
            }
          ]
        }
      }
    ],
    "chaos": {
      "enabled": false,
      "seed": "prismacloud-prismacloudv2",
      "mode": "probability",
      "probability": 0.25,
      "everyNth": 5,
      "duplicateRecords": false,
      "missingFields": false,
      "mixedTimestamps": false,
      "outOfOrder": false,
      "wrongTypes": false,
      "truncatedJson": false,
      "slowDrip": false,
      "partial": false,
      "malformedJson": false,
      "wrongContentType": false,
      "randomErrors": false,
      "latency": false,
      "paginationGlitch": "none",
      "malformedXml": false,
      "wrongNamespace": false,
      "soapFault": false,
      "authExpired": false,
      "authDenied": false,
      "authTokenFailure": false,
      "authClockSkew": false
    },
    "totalRecords": 500,
    "auth": {
      "mode": "none"
    }
  }
}
