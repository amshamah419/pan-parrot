    "operations": [
      {
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "offset",
          "limitParam": "limit",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 10,
          "maxLimit": 100
        },
        "id": "list-threats",
        "method": "GET",
        "pathTemplate": "/web/api/v2.1/threats",
        "summary": "List threats",
        "status": 200,
        "list": true,
        "envelope": {
          "type": "wrapped",
          "arrayKey": "data"
        },
        "record": {
          "name": "threat",
          "kind": "object",
          "children": [
            {
              "name": "id",
              "kind": "id"
            },
            {
              "name": "threatInfo",
              "kind": "object",
              "children": [
                {
                  "name": "threatName",
                  "kind": "string",
                  "example": "EICAR test file"
                },
                {
                  "name": "createdAt",
                  "kind": "timestamp",
                  "format": "iso"
                },
                {
                  "name": "classification",
                  "kind": "enum",
                  "enumValues": [
                    "Malware",
                    "PUA",
                    "Suspicious"
                  ]
                }
              ]
            },
            {
              "name": "agentRealtimeInfo",
              "kind": "object",
              "children": [
                {
                  "name": "agentComputerName",
                  "kind": "string",
                  "example": "lab-workstation"
                }
              ]
            }
          ]
        }
      }
    ],
    "chaos": {
