{
  "id": "sentinelone-sentinelone-v2",
  "name": "SentinelOne v2",
  "pack": "SentinelOne",
  "vendor": "SentinelOne",
  "fidelity": "verified",
  "curated": true,
  "summary": "GET /web/api/v2.1/threats returns the data array.",
  "notes": [
    "The threats list is { data: [...], pagination }. This mock returns data and ignores the pagination object. limit and cursor query parameters page the array.",
    "Activities and cloud detection alerts are separate routes in the event collector and are not modeled here.",
    "Authorization must be ApiToken plus the dummy token. The management console host is the catch URL."
  ],
  "attribution": "Checked against the vendor's public API reference. Sample field names also follow demisto/content (MIT). See /presets/ATTRIBUTION.md.",
  "sourceUrl": "https://github.com/demisto/content/tree/master/Packs/SentinelOne/Integrations/SentinelOne",
  "spec": {
    "version": 1,
    "source": {
      "kind": "preset",
      "id": "sentinelone-sentinelone-v2",
      "name": "SentinelOne v2",
      "fidelity": "verified",
      "attribution": "Vendor public API reference plus demisto/content (MIT).",
      "sourceUrl": "https://usea1-partners.sentinelone.net/api-doc/overview",
      "notes": [],
      "verification": {
        "status": "verified",
        "docUrl": "https://usea1-partners.sentinelone.net/api-doc/overview",
        "checkedAt": "2026-11-09",
        "differences": [
          "The threats list is { data: [...], pagination }. This mock returns data and ignores the pagination object. limit and cursor query parameters page the array.",
          "Activities and cloud detection alerts are separate routes in the event collector and are not modeled here.",
          "Authorization must be ApiToken plus the dummy token. The management console host is the catch URL."
        ]
      }
    },
    "operations": [
      {
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "cursor",
          "limitParam": "limit",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 10,
          "maxLimit": 100
        },
        "id": "list-threats",
        "method": "GET",
        "pathTemplate": "/web/api/v2.1/threats",
        "summary": "List threats",
        "status": 200,
        "list": true,
        "envelope": {
          "type": "wrapped",
          "arrayKey": "data"
        },
        "record": {
          "name": "threat",
          "kind": "object",
          "children": [
            {
              "name": "id",
              "kind": "id"
            },
            {
              "name": "threatInfo",
              "kind": "object",
              "children": [
                {
                  "name": "threatName",
                  "kind": "string",
                  "example": "EICAR test file"
                },
                {
                  "name": "createdAt",
                  "kind": "timestamp",
                  "format": "iso"
                },
                {
                  "name": "classification",
                  "kind": "enum",
                  "enumValues": [
                    "Malware",
                    "PUA",
                    "Suspicious"
                  ]
                }
              ]
            },
            {
              "name": "agentRealtimeInfo",
              "kind": "object",
              "children": [
                {
                  "name": "agentComputerName",
                  "kind": "string",
                  "example": "lab-workstation"
                }
              ]
            }
          ]
        }
      }
    ],
    "chaos": {
      "enabled": false,
      "seed": "sentinelone-sentinelone-v2",
      "mode": "probability",
      "probability": 0.25,
      "everyNth": 5,
      "duplicateRecords": false,
      "missingFields": false,
      "mixedTimestamps": false,
      "outOfOrder": false,
      "wrongTypes": false,
      "truncatedJson": false,
      "slowDrip": false,
      "partial": false,
      "malformedJson": false,
      "wrongContentType": false,
      "randomErrors": false,
      "latency": false,
      "paginationGlitch": "none",
      "malformedXml": false,
      "wrongNamespace": false,
      "soapFault": false,
      "authExpired": false,
      "authDenied": false,
      "authTokenFailure": false,
      "authClockSkew": false
    },
    "totalRecords": 500,
    "auth": {
      "mode": "api-key",
      "apiKey": {
        "in": "header",
        "name": "Authorization",
        "value": "ApiToken dummy-s1-token"
      }
    }
  }
}
