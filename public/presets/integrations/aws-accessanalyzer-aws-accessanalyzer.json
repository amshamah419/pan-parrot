    },
    "operations": [
      {
        "id": "list-findings",
        "method": "POST",
        "pathTemplate": "/",
        "summary": "List findings",
        "status": 200,
        "list": true,
        "envelope": {
          "type": "wrapped",
          "arrayKey": "findings"
        },
        "headerMatch": {
          "x-amz-target": "AccessAnalyzer.ListFindings"
        },
        "record": {
          "name": "finding",
          "kind": "object",
          "children": [
            {
              "name": "id",
              "kind": "uuid"
            },
            {
              "name": "resource",
              "kind": "string",
              "example": "arn:aws:s3:::lab-bucket"
            },
            {
              "name": "status",
              "kind": "enum",
              "enumValues": [
                "ACTIVE",
                "ARCHIVED"
              ]
            },
            {
              "name": "createdAt",
              "kind": "timestamp"
            }
          ]
        },
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "cursor",
          "limitParam": "maxResults",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "nextToken",
          "defaultLimit": 20,
          "maxLimit": 500
        }
      }
    ],
    "chaos": {
      "enabled": false,
      "seed": "aws-accessanalyzer-aws-accessanalyzer",
      "mode": "probability",
      "probability": 0.25,
      "everyNth": 5,
