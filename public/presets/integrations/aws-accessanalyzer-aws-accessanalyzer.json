    "source": {
      "kind": "preset",
      "id": "aws-accessanalyzer-aws-accessanalyzer",
      "name": "AWS - Access Analyzer",
      "fidelity": "verified",
      "attribution": "Public API reference or demisto/content client (MIT).",
      "sourceUrl": "https://docs.aws.amazon.com/access-analyzer/latest/APIReference/API_ListFindings.html",
      "notes": [
        "POST / with X-Amz-Target AccessAnalyzer.ListFindings returns { findings }.",
        "The analyzer ARN is a path segment in the real API and is omitted here.",
