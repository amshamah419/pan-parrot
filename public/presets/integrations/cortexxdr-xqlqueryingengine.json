  "spec": {
    "version": 1,
    "source": {
      "kind": "preset",
      "id": "cortexxdr-xqlqueryingengine",
      "name": "Cortex XDR - XQL Query Engine",
      "fidelity": "guessed",
      "attribution": "Public API reference or demisto/content client (MIT).",
      "sourceUrl": "https://docs-cortex.paloaltonetworks.com/r/Cortex-XDR-REST-API/Start-an-XQL-Query",
      "notes": [
        "Cross-check: unparseable: no HTTP calls and no test_data"
      ]
    },
    "operations": [
      {
        "id": "start",
        "method": "POST",
        "pathTemplate": "/public_api/v1/xql/start_xql_query",
        "summary": "Start an XQL query",
        "status": 200,
        "list": false,
        "envelope": {
          "type": "object"
        },
        "record": {
          "name": "body",
          "kind": "object",
          "children": [
            {
              "name": "reply",
              "kind": "object",
              "children": [
                {
                  "name": "execution_id",
                  "kind": "id"
                }
              ]
            }
          ]
        },
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "none",
          "limitParam": "limit",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 20,
          "maxLimit": 500
        }
      },
      {
        "id": "results",
        "method": "POST",
        "pathTemplate": "/public_api/v1/xql/get_query_results",
        "summary": "Get XQL results",
        "status": 200,
        "list": false,
        "envelope": {
          "type": "object"
        },
        "record": {
          "name": "body",
          "kind": "object",
          "children": [
            {
              "name": "reply",
              "kind": "object",
              "children": [
                {
                  "name": "status",
                  "kind": "const",
                  "constValue": "SUCCESS"
                },
                {
                  "name": "number_of_results",
                  "kind": "integer"
                },
                {
                  "name": "results",
                  "kind": "object",
                  "children": [
                    {
                      "name": "data",
                      "kind": "array",
                      "minItems": 1,
                      "maxItems": 1,
                      "item": {
                        "name": "row",
                        "kind": "object",
                        "children": [
                          {
                            "name": "action_process_image_name",
                            "kind": "string",
                            "example": "cmd.exe"
                          },
                          {
                            "name": "agent_hostname",
                            "kind": "string",
                            "example": "lab-host"
                          },
                          {
                            "name": "_time",
                            "kind": "timestamp",
                            "format": "iso"
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "none",
          "limitParam": "limit",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 20,
          "maxLimit": 500
        }
      }
    ],
    "chaos": {
      "enabled": false,
      "seed": "cortexxdr-xqlqueryingengine",
      "mode": "probability",
      "probability": 0.25,
      "everyNth": 5,
      "duplicateRecords": false,
      "missingFields": false,
      "mixedTimestamps": false,
      "outOfOrder": false,
      "wrongTypes": false,
      "truncatedJson": false,
      "slowDrip": false,
      "partial": false,
      "malformedJson": false,
      "wrongContentType": false,
      "randomErrors": false,
      "latency": false,
      "paginationGlitch": "none",
      "malformedXml": false,
      "wrongNamespace": false,
      "soapFault": false,
      "authExpired": false,
      "authDenied": false,
      "authTokenFailure": false,
      "authClockSkew": false,
      "graphqlErrors": false
    },
    "totalRecords": 40,
    "auth": {
      "mode": "api-key",
      "apiKey": {
        "in": "header",
        "name": "x-xdr-auth-id",
        "value": "dummy-key"
      }
    }
  }
}
