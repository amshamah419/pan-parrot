    "operations": [
      {
        "id": "get-findings",
        "method": "POST",
        "pathTemplate": "/",
        "summary": "Get findings",
        "status": 200,
        "list": true,
        "envelope": {
          "type": "wrapped",
          "arrayKey": "Findings"
        },
        "headerMatch": {
          "x-amz-target": "GuardDuty_20171201.GetFindings"
        },
        "record": {
          "name": "finding",
          "kind": "object",
          "children": [
            {
              "name": "Id",
              "kind": "id"
            },
            {
              "name": "Type",
              "kind": "string",
              "example": "Recon:EC2/PortProbeUnprotectedPort"
            },
            {
              "name": "Severity",
              "kind": "number"
            },
            {
              "name": "Title",
              "kind": "string",
              "example": "Port probe"
            },
            {
              "name": "UpdatedAt",
              "kind": "timestamp"
            }
          ]
        },
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "none",
          "limitParam": "limit",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 20,
          "maxLimit": 500
        }
      }
    ],
    "chaos": {
      "enabled": false,
      "seed": "aws-guardduty-awsguarddutyeventcollector",
      "mode": "probability",
