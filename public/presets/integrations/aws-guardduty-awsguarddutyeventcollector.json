  "spec": {
    "version": 1,
    "source": {
      "kind": "preset",
      "id": "aws-guardduty-awsguarddutyeventcollector",
      "name": "AWS - GuardDuty Event Collector",
      "fidelity": "verified",
      "attribution": "Public API reference or demisto/content client (MIT).",
      "sourceUrl": "https://docs.aws.amazon.com/guardduty/latest/APIReference/API_GetFindings.html",
      "notes": [
        "POST / with X-Amz-Target GuardDuty_20171201.GetFindings returns { Findings } with Id, Type, Severity, and Title.",
        "This is the collector integration. ListFindings is on the other GuardDuty preset.",
        "SigV4 is not checked."
      ],
      "verification": {
        "status": "verified",
        "docUrl": "https://docs.aws.amazon.com/guardduty/latest/APIReference/API_GetFindings.html",
        "checkedAt": "2026-11-10",
        "differences": [
          "POST / with X-Amz-Target GuardDuty_20171201.GetFindings returns { Findings } with Id, Type, Severity, and Title.",
