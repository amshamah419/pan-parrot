  "spec": {
    "version": 1,
    "source": {
      "kind": "preset",
      "id": "darktrace-darktrace",
      "name": "Darktrace",
      "fidelity": "verified",
      "attribution": "Public API reference or demisto/content test fixture (MIT).",
      "sourceUrl": "https://github.com/demisto/content/blob/master/Packs/Darktrace/Integrations/Darktrace/test_data/breach_details.json",
      "notes": [
        "GET /modelbreaches returns a JSON array. The formatter reads pbid, score, time, commentCount, device fields, and model.then (name, pid, uuid, tags, priority, description). model.name is the formatted copy, not the response."
      ],
      "verification": {
        "status": "verified",
        "docUrl": "https://github.com/demisto/content/blob/master/Packs/Darktrace/Integrations/Darktrace/test_data/breach_details.json",
        "checkedAt": "2026-11-10",
        "differences": [
          "GET /modelbreaches returns a JSON array. The formatter reads pbid, score, time, commentCount, device fields, and model.then (name, pid, uuid, tags, priority, description). model.name is the formatted copy, not the response."
        ]
      }
    },
    "operations": [
      {
        "id": "list-breaches",
        "method": "GET",
        "pathTemplate": "/modelbreaches",
        "summary": "List model breaches",
        "status": 200,
        "list": true,
        "envelope": {
          "type": "array"
        },
        "record": {
          "name": "breach",
          "kind": "object",
          "children": [
            {
              "name": "pbid",
              "kind": "integer",
              "example": 95
            },
            {
              "name": "score",
              "kind": "number",
              "example": 0.65
            },
            {
              "name": "time",
              "kind": "timestamp",
              "example": "2021-08-24T11:08:22.000Z"
            },
            {
              "name": "commentCount",
              "kind": "integer",
              "example": 0
            },
            {
              "name": "device",
              "kind": "object",
              "children": [
                {
                  "name": "did",
                  "kind": "string",
                  "example": "1272"
                },
                {
                  "name": "hostname",
                  "kind": "string",
                  "example": "ftp.test.com"
                },
                {
                  "name": "ip",
                  "kind": "ip",
                  "example": "10.18.45.52"
                },
                {
                  "name": "macaddress",
                  "kind": "string",
                  "example": "00:11:22:33:44:55"
                },
                {
                  "name": "vendor",
                  "kind": "string",
                  "example": "VMware, Inc."
                },
                {
                  "name": "devicelabel",
                  "kind": "string",
                  "example": "desktop"
                }
              ]
            },
            {
              "name": "model",
              "kind": "object",
              "children": [
                {
                  "name": "then",
                  "kind": "object",
                  "children": [
                    {
                      "name": "name",
                      "kind": "string",
                      "example": "Compromise::Ransomware"
                    },
                    {
                      "name": "pid",
                      "kind": "integer",
                      "example": 287
                    },
                    {
                      "name": "uuid",
                      "kind": "string",
                      "example": "80010119-6d7f-0000-0305-5e0000000325"
                    },
                    {
                      "name": "tags",
                      "kind": "array",
                      "item": {
                        "name": "item",
                        "kind": "string",
                        "example": "AP: Exploit"
                      }
                    },
                    {
                      "name": "priority",
                      "kind": "integer",
                      "example": 4
                    },
                    {
                      "name": "description",
                      "kind": "string",
                      "example": "A device is writing suspicious terms."
                    }
                  ]
                }
              ]
            }
          ]
        },
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "offset",
          "limitParam": "limit",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 20,
          "maxLimit": 500
        }
      }
    ],
    "chaos": {
      "enabled": false,
      "seed": "darktrace-darktrace",
      "mode": "probability",
      "probability": 0.25,
      "everyNth": 5,
      "duplicateRecords": false,
      "missingFields": false,
      "mixedTimestamps": false,
      "outOfOrder": false,
      "wrongTypes": false,
      "truncatedJson": false,
      "slowDrip": false,
      "partial": false,
      "malformedJson": false,
      "wrongContentType": false,
      "randomErrors": false,
      "latency": false,
      "paginationGlitch": "none",
      "malformedXml": false,
      "wrongNamespace": false,
      "soapFault": false,
      "authExpired": false,
      "authDenied": false,
      "authTokenFailure": false,
      "authClockSkew": false,
      "graphqlErrors": false
    },
    "totalRecords": 200,
    "auth": {
      "mode": "none"
    }
  }
}
