                    {
                      "name": "value",
                      "kind": "integer"
                    },
                    {
                      "name": "relation",
                      "kind": "const",
                      "constValue": "eq"
                    }
                  ]
                },
                {
                  "name": "hits",
                  "kind": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "item": {
                    "name": "hit",
                    "kind": "object",
                    "children": [
                      {
                        "name": "_index",
                        "kind": "const",
                        "constValue": "lab-logs"
                      },
                      {
                        "name": "_id",
                        "kind": "id"
                      },
                      {
                        "name": "_source",
                        "kind": "object",
                        "children": [
                          {
                            "name": "@timestamp",
                            "kind": "timestamp",
                            "format": "iso"
                          },
                          {
                            "name": "message",
                            "kind": "string",
                            "example": "user=ada action=login"
                          },
                          {
                            "name": "host",
                            "kind": "string",
                            "example": "lab-host"
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
