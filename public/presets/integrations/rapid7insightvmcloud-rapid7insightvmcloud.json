    "operations": [
      {
        "id": "assets",
        "method": "GET",
        "pathTemplate": "/v4/integration/assets",
        "summary": "Search assets",
        "status": 200,
        "list": false,
        "envelope": {
          "type": "object"
        },
        "record": {
          "name": "body",
          "kind": "object",
          "children": [
            {
              "name": "data",
              "kind": "array",
              "minItems": 1,
              "maxItems": 1,
              "item": {
                "name": "asset",
                "kind": "object",
                "children": [
                  {
                    "name": "id",
                    "kind": "id"
                  },
                  {
                    "name": "host_name",
                    "kind": "string",
                    "example": "lab-host"
                  },
                  {
                    "name": "ip",
                    "kind": "ip"
                  }
                ]
              }
            }
          ]
        },
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "none",
          "limitParam": "limit",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 20,
          "maxLimit": 500
        }
      },
      {
        "id": "vulns",
        "method": "GET",
        "pathTemplate": "/v4/integration/vulnerabilities",
        "summary": "Search vulnerabilities",
        "status": 200,
        "list": false,
        "envelope": {
          "type": "object"
        },
        "record": {
          "name": "body",
          "kind": "object",
          "children": [
            {
              "name": "data",
              "kind": "array",
              "minItems": 1,
              "maxItems": 1,
              "item": {
                "name": "vuln",
                "kind": "object",
                "children": [
                  {
                    "name": "id",
                    "kind": "id"
                  },
                  {
                    "name": "title",
                    "kind": "string",
                    "example": "Lab CVE"
                  },
                  {
                    "name": "severity",
                    "kind": "enum",
                    "enumValues": [
                      "low",
                      "medium",
                      "high",
                      "critical"
                    ]
                  }
                ]
              }
            }
          ]
        },
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "none",
          "limitParam": "limit",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 20,
          "maxLimit": 500
        }
      }
    ],
    "chaos": {
      "enabled": false,
      "seed": "rapid7insightvmcloud-rapid7insightvmcloud",
      "mode": "probability",
      "probability": 0.25,
