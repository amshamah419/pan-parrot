{
  "id": "autofocus-autofocusv2",
  "name": "Palo Alto Networks AutoFocus v2 (Deprecated)",
  "pack": "AutoFocus",
  "vendor": "Palo Alto Networks",
  "fidelity": "verified",
  "curated": true,
  "summary": "Sample search and threat indicator context.",
  "notes": [
    "The client posts /api/v1.0/samples/search and reads hits, then GETs /api/v1.0/tic. The pack is marked deprecated in XSOAR.",
    "The search cookie poll at /samples/results/{cookie} is not modeled. This mock returns hits on the search call.",
    "The AutoFocus API page was not reloaded. The apiKey header is the dummy key."
  ],
  "attribution": "Checked against a public vendor reference or, when that page was not reloaded, the demisto/content client. See /presets/ATTRIBUTION.md.",
  "sourceUrl": "https://github.com/demisto/content/tree/master/Packs/AutoFocus/Integrations/AutofocusV2",
  "spec": {
    "version": 1,
    "source": {
      "kind": "preset",
      "id": "autofocus-autofocusv2",
      "name": "Palo Alto Networks AutoFocus v2 (Deprecated)",
      "fidelity": "verified",
      "attribution": "Public API reference or demisto/content client (MIT).",
      "sourceUrl": "https://docs.paloaltonetworks.com/autofocus/autofocus-api/about-the-autofocus-api",
      "notes": [
        "The client posts /api/v1.0/samples/search and reads hits, then GETs /api/v1.0/tic. The pack is marked deprecated in XSOAR.",
        "The search cookie poll at /samples/results/{cookie} is not modeled. This mock returns hits on the search call.",
        "The AutoFocus API page was not reloaded. The apiKey header is the dummy key."
      ],
      "verification": {
        "status": "verified",
        "docUrl": "https://docs.paloaltonetworks.com/autofocus/autofocus-api/about-the-autofocus-api",
        "checkedAt": "2026-11-10",
        "differences": [
          "The client posts /api/v1.0/samples/search and reads hits, then GETs /api/v1.0/tic. The pack is marked deprecated in XSOAR.",
          "The search cookie poll at /samples/results/{cookie} is not modeled. This mock returns hits on the search call.",
          "The AutoFocus API page was not reloaded. The apiKey header is the dummy key."
        ]
      }
    },
    "operations": [
      {
        "id": "samples-search",
        "method": "POST",
        "pathTemplate": "/api/v1.0/samples/search",
        "summary": "Search samples",
        "status": 200,
        "list": false,
        "envelope": {
          "type": "object"
        },
        "record": {
          "name": "body",
          "kind": "object",
          "children": [
            {
              "name": "autofocus_cookie",
              "kind": "id"
            },
            {
              "name": "total",
              "kind": "integer"
            },
            {
              "name": "hits",
              "kind": "array",
              "minItems": 1,
              "maxItems": 1,
              "item": {
                "name": "hit",
                "kind": "object",
                "children": [
                  {
                    "name": "_id",
                    "kind": "id"
                  },
                  {
                    "name": "sha256",
                    "kind": "id"
                  },
                  {
                    "name": "verdict",
                    "kind": "enum",
                    "enumValues": [
                      "malware",
                      "benign",
                      "grayware"
                    ]
                  }
                ]
              }
            }
          ]
        },
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "none",
          "limitParam": "limit",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 20,
          "maxLimit": 500
        }
      },
      {
        "id": "tic",
        "method": "GET",
        "pathTemplate": "/api/v1.0/tic",
        "summary": "Threat indicator context",
        "status": 200,
        "list": false,
        "envelope": {
          "type": "object"
        },
        "record": {
          "name": "body",
          "kind": "object",
          "children": [
            {
              "name": "indicator",
              "kind": "string",
              "example": "8.8.8.8"
            },
            {
              "name": "indicatorType",
              "kind": "const",
              "constValue": "ipv4"
            },
            {
              "name": "tags",
              "kind": "array",
              "minItems": 1,
              "maxItems": 1,
              "item": {
                "name": "tag",
                "kind": "object",
                "children": [
                  {
                    "name": "tag_name",
                    "kind": "string",
                    "example": "lab-malware"
                  },
                  {
                    "name": "public_tag_name",
                    "kind": "string",
                    "example": "Malware"
                  }
                ]
              }
            }
          ]
        },
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "none",
          "limitParam": "limit",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 20,
          "maxLimit": 500
        }
      }
    ],
    "chaos": {
      "enabled": false,
      "seed": "autofocus-autofocusv2",
      "mode": "probability",
      "probability": 0.25,
      "everyNth": 5,
      "duplicateRecords": false,
      "missingFields": false,
      "mixedTimestamps": false,
      "outOfOrder": false,
      "wrongTypes": false,
      "truncatedJson": false,
      "slowDrip": false,
      "partial": false,
      "malformedJson": false,
      "wrongContentType": false,
      "randomErrors": false,
      "latency": false,
      "paginationGlitch": "none",
      "malformedXml": false,
      "wrongNamespace": false,
      "soapFault": false,
      "authExpired": false,
      "authDenied": false,
      "authTokenFailure": false,
      "authClockSkew": false,
      "graphqlErrors": false
    },
    "totalRecords": 40,
    "auth": {
      "mode": "api-key",
      "apiKey": {
        "in": "header",
        "name": "apiKey",
        "value": "dummy-autofocus-key"
      }
    }
  }
}
