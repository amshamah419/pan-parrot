        "id": "list-findings",
        "method": "POST",
        "pathTemplate": "/",
        "summary": "List finding ids",
        "status": 200,
        "list": true,
        "envelope": {
          "type": "wrapped",
          "arrayKey": "FindingIds"
        },
        "record": {
          "name": "findingId",
          "kind": "id"
