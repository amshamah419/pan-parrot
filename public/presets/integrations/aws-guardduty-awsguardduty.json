        "id": "get-findings",
        "method": "POST",
        "pathTemplate": "/",
        "summary": "Get findings",
        "status": 200,
        "list": true,
        "envelope": {
          "type": "wrapped",
          "arrayKey": "Findings"
        },
        "record": {
          "name": "finding",
          "kind": "object",
          "children": [
            {
              "name": "Id",
              "kind": "id"
            },
            {
              "name": "Type",
              "kind": "string",
              "example": "Recon:EC2/PortProbeUnprotectedPort"
            },
            {
              "name": "Severity",
              "kind": "number"
            },
            {
              "name": "Title",
              "kind": "string",
              "example": "Port probe on an unprotected port"
            },
            {
              "name": "UpdatedAt",
              "kind": "timestamp",
              "format": "iso"
            }
          ]
        },
        "headerMatch": {
          "x-amz-target": "GuardDuty_20171201.GetFindings"
        }
      }
