  "spec": {
    "version": 1,
    "source": {
      "kind": "preset",
      "id": "recordedfutureasi-recordedfutureasi",
      "name": "Recorded Future Attack Surface Intelligence",
      "fidelity": "verified",
      "attribution": "Public API reference or demisto/content client (MIT).",
      "sourceUrl": "https://docs.securitytrails.com/docs/overview",
      "notes": [
        "The client base is hardcoded to https://api.securitytrails.com/v1/asi. Fetch calls /rules/{project}/recent/issues and reads data plus meta.snapshot.",
        "The earlier mock used snapshot latest and an issues array. Activity history is not modeled.",
        "The SecurityTrails overview was not reloaded. The API key header is the dummy key."
      ],
      "verification": {
        "status": "verified",
        "docUrl": "https://docs.securitytrails.com/docs/overview",
        "checkedAt": "2026-11-10",
        "differences": [
          "The client base is hardcoded to https://api.securitytrails.com/v1/asi. Fetch calls /rules/{project}/recent/issues and reads data plus meta.snapshot.",
          "The earlier mock used snapshot latest and an issues array. Activity history is not modeled.",
          "The SecurityTrails overview was not reloaded. The API key header is the dummy key."
        ]
      }
    },
    "operations": [
      {
        "id": "issues",
        "method": "GET",
        "pathTemplate": "/v1/asi/rules/lab-project/recent/issues",
        "summary": "List issues",
        "status": 200,
        "list": false,
        "envelope": {
          "type": "object"
        },
        "record": {
          "name": "body",
          "kind": "object",
          "children": [
            {
              "name": "meta",
              "kind": "object",
              "children": [
                {
                  "name": "snapshot",
                  "kind": "const",
                  "constValue": "recent"
                }
              ]
            },
            {
              "name": "data",
              "kind": "array",
              "minItems": 1,
              "maxItems": 1,
              "item": {
                "name": "rule",
                "kind": "object",
                "children": [
                  {
                    "name": "name",
                    "kind": "string",
                    "example": "Open admin port"
                  },
                  {
                    "name": "description",
                    "kind": "string",
                    "example": "An admin port is exposed"
                  },
                  {
                    "name": "classification",
                    "kind": "enum",
                    "enumValues": [
                      "informational",
                      "moderate",
                      "high"
                    ]
                  },
                  {
                    "name": "example_entities",
                    "kind": "object",
                    "children": [
                      {
                        "name": "domains",
                        "kind": "array",
                        "minItems": 1,
                        "maxItems": 1,
                        "item": {
                          "name": "domain",
                          "kind": "const",
                          "constValue": "lab.example"
                        }
                      },
                      {
                        "name": "ips",
                        "kind": "array",
                        "minItems": 1,
                        "maxItems": 1,
                        "item": {
                          "name": "ip",
                          "kind": "const",
                          "constValue": "203.0.113.10"
                        }
                      }
                    ]
                  },
                  {
                    "name": "rule_metadata",
                    "kind": "object",
                    "children": [
                      {
                        "name": "entity_counts",
                        "kind": "object",
                        "children": [
                          {
                            "name": "domains",
                            "kind": "integer"
                          },
                          {
                            "name": "ips",
                            "kind": "integer"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          ]
        },
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "none",
          "limitParam": "limit",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 20,
          "maxLimit": 500
        }
      }
    ],
    "chaos": {
      "enabled": false,
      "seed": "recordedfutureasi-recordedfutureasi",
      "mode": "probability",
      "probability": 0.25,
      "everyNth": 5,
      "duplicateRecords": false,
      "missingFields": false,
      "mixedTimestamps": false,
      "outOfOrder": false,
      "wrongTypes": false,
      "truncatedJson": false,
      "slowDrip": false,
      "partial": false,
      "malformedJson": false,
      "wrongContentType": false,
      "randomErrors": false,
      "latency": false,
      "paginationGlitch": "none",
      "malformedXml": false,
      "wrongNamespace": false,
      "soapFault": false,
      "authExpired": false,
      "authDenied": false,
      "authTokenFailure": false,
      "authClockSkew": false,
      "graphqlErrors": false
    },
    "totalRecords": 40,
    "auth": {
      "mode": "api-key",
      "apiKey": {
        "in": "header",
        "name": "APIKEY",
        "value": "dummy-key"
      }
    }
  }
