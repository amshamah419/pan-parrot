{
  "id": "tenable-io-tenable-io",
  "name": "Tenable Vulnerability Management (formerly Tenable.io)",
  "pack": "Tenable_io",
  "vendor": "Tenable",
  "fidelity": "guessed",
  "curated": true,
  "summary": "GET /workbenches/assets and POST /vulns/export, which the XSOAR client calls.",
  "notes": [
    "Cross-check: path: GET /workbenches/assets is not a client call. Closest: /{BASE_URL}workbenches/assets (1)."
  ],
  "attribution": "Checked against the vendor's public API reference. Sample field names also follow demisto/content (MIT). See /presets/ATTRIBUTION.md.",
  "sourceUrl": "https://github.com/demisto/content/tree/master/Packs/Tenable_io/Integrations/Tenable_io",
  "spec": {
    "version": 1,
    "source": {
      "kind": "preset",
      "id": "tenable-io-tenable-io",
      "name": "Tenable Vulnerability Management (formerly Tenable.io)",
      "fidelity": "guessed",
      "attribution": "Vendor public API reference plus demisto/content (MIT).",
      "sourceUrl": "https://developer.tenable.com/reference/workbenches-assets",
      "notes": [
        "Cross-check: path: GET /workbenches/assets is not a client call. Closest: /{BASE_URL}workbenches/assets (1)."
      ]
    },
    "operations": [
      {
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "offset",
          "limitParam": "limit",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 50,
          "maxLimit": 500
        },
        "id": "list-assets",
        "method": "GET",
        "pathTemplate": "/workbenches/assets",
        "summary": "List workbench assets",
        "status": 200,
        "list": true,
        "envelope": {
          "type": "wrapped",
          "arrayKey": "assets"
        },
        "record": {
          "name": "asset",
          "kind": "object",
          "children": [
            {
              "name": "id",
              "kind": "uuid"
            },
            {
              "name": "ipv4",
              "kind": "ip"
            },
            {
              "name": "hostname",
              "kind": "string",
              "example": "lab-workstation"
            },
            {
              "name": "last_seen",
              "kind": "timestamp",
              "format": "iso"
            }
          ]
        }
      },
      {
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "none",
          "limitParam": "limit",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 1,
          "maxLimit": 1
        },
        "id": "export-vulns",
        "method": "POST",
        "pathTemplate": "/vulns/export",
        "summary": "Start a vulnerability export",
        "status": 200,
        "list": false,
        "envelope": {
          "type": "object"
        },
        "record": {
          "name": "export",
          "kind": "object",
          "children": [
            {
              "name": "export_uuid",
              "kind": "uuid"
            }
          ]
        }
      }
    ],
    "chaos": {
      "enabled": false,
      "seed": "tenable-io-tenable-io",
      "mode": "probability",
      "probability": 0.25,
      "everyNth": 5,
      "duplicateRecords": false,
      "missingFields": false,
      "mixedTimestamps": false,
      "outOfOrder": false,
      "wrongTypes": false,
      "truncatedJson": false,
      "slowDrip": false,
      "partial": false,
      "malformedJson": false,
      "wrongContentType": false,
      "randomErrors": false,
      "latency": false,
      "paginationGlitch": "none",
      "malformedXml": false,
      "wrongNamespace": false,
      "soapFault": false,
      "authExpired": false,
      "authDenied": false,
      "authTokenFailure": false,
      "authClockSkew": false
    },
    "totalRecords": 500,
    "auth": {
      "mode": "api-key",
      "apiKey": {
        "in": "header",
        "name": "X-ApiKeys",
        "value": "accessKey=dummy-access; secretKey=dummy-secret"
      }
    }
  }
}
