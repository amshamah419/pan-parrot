        "method": "GET",
        "pathTemplate": "/rest/api/3/search",
        "summary": "Legacy issue search",
        "status": 200,
        "list": true,
        "envelope": {
          "type": "wrapped",
          "arrayKey": "issues"
        },
        "record": {
          "name": "issue",
          "kind": "object",
          "children": [
