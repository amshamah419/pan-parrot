  "attribution": "Checked against a public vendor reference or, when that page is blocked, the integration test fixture plus the public client. See /presets/ATTRIBUTION.md.",
  "sourceUrl": "https://github.com/demisto/content/tree/master/Packs/AbnormalSecurity/Integrations/AbnormalSecurityEventCollector",
  "spec": {
    "version": 1,
    "source": {
      "kind": "preset",
      "id": "abnormalsecurity-abnormalsecurityeventcollector",
      "name": "Abnormal Security Event Collector",
      "fidelity": "verified",
      "attribution": "Public API reference or demisto/content client (MIT).",
      "sourceUrl": "https://abnormalsecurity.readme.io/reference/get_threats",
      "notes": [
        "GET /threats returns { threats }. The collector polls the same list as the main Abnormal integration.",
        "The readme was not reloaded. pageNumber and pageSize page the list.",
        "A bearer token is required."
      ],
      "verification": {
        "status": "verified",
        "docUrl": "https://abnormalsecurity.readme.io/reference/get_threats",
        "checkedAt": "2026-11-10",
        "differences": [
          "GET /threats returns { threats }. The collector polls the same list as the main Abnormal integration.",
          "The readme was not reloaded. pageNumber and pageSize page the list.",
          "A bearer token is required."
        ]
      }
    },
    "operations": [
      {
        "id": "threats",
        "method": "GET",
        "pathTemplate": "/threats",
        "summary": "List threats",
        "status": 200,
        "list": true,
        "envelope": {
          "type": "wrapped",
          "arrayKey": "threats"
        },
        "record": {
          "name": "threat",
          "kind": "object",
          "children": [
            {
              "name": "threatId",
              "kind": "id"
            },
            {
              "name": "subject",
              "kind": "string",
              "example": "Payroll change"
            },
            {
              "name": "fromAddress",
              "kind": "email"
            },
            {
              "name": "receivedTime",
              "kind": "timestamp"
            },
            {
              "name": "attackType",
              "kind": "enum",
              "enumValues": [
                "Phishing",
                "Malware"
              ]
            }
          ]
        },
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "page",
          "limitParam": "pageSize",
          "offsetParam": "offset",
          "pageParam": "pageNumber",
          "cursorParam": "cursor",
          "defaultLimit": 20,
          "maxLimit": 500
        }
      }
    ],
    "chaos": {
      "enabled": false,
      "seed": "abnormalsecurity-abnormalsecurityeventcollector",
      "mode": "probability",
      "probability": 0.25,
      "everyNth": 5,
      "duplicateRecords": false,
      "missingFields": false,
      "mixedTimestamps": false,
      "outOfOrder": false,
      "wrongTypes": false,
      "truncatedJson": false,
      "slowDrip": false,
      "partial": false,
      "malformedJson": false,
      "wrongContentType": false,
      "randomErrors": false,
      "latency": false,
      "paginationGlitch": "none",
      "malformedXml": false,
      "wrongNamespace": false,
      "soapFault": false,
      "authExpired": false,
      "authDenied": false,
      "authTokenFailure": false,
      "authClockSkew": false,
      "graphqlErrors": false
    },
    "totalRecords": 40,
    "auth": {
      "mode": "bearer",
      "bearer": {
        "token": "dummy-bearer"
      }
    }
  }
}
