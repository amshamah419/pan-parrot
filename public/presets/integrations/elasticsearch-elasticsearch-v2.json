{
  "id": "elasticsearch-elasticsearch-v2",
  "name": "Elasticsearch v2",
  "pack": "Elasticsearch",
  "vendor": "Elastic",
  "fidelity": "verified",
  "curated": true,
  "summary": "POST /{index}/_search returns the hits envelope the Elasticsearch client reads.",
  "notes": [
    "The public search response is { took, hits: { total, hits: [ { _index, _id, _source } ] } }. This mock returns that shape.",
    "total is a number on clusters before 7.0 and an object after. This mock uses the 7+ object. Shards, timed_out, and aggregations are omitted.",
    "Basic auth is checked with the dummy elastic user. API keys and the Elastic Cloud host are not modeled."
  ],
  "attribution": "Checked against the vendor's public API reference. Sample field names also follow demisto/content (MIT). See /presets/ATTRIBUTION.md.",
  "sourceUrl": "https://github.com/demisto/content/tree/master/Packs/Elasticsearch/Integrations/Elasticsearch_v2",
  "spec": {
    "version": 1,
    "source": {
      "kind": "preset",
      "id": "elasticsearch-elasticsearch-v2",
      "name": "Elasticsearch v2",
      "fidelity": "verified",
      "attribution": "Vendor public API reference plus demisto/content (MIT).",
      "sourceUrl": "https://www.elastic.co/docs/api/doc/elasticsearch/operation/operation-search",
      "notes": [],
      "verification": {
        "status": "verified",
        "docUrl": "https://www.elastic.co/docs/api/doc/elasticsearch/operation/operation-search",
        "checkedAt": "2026-11-09",
        "differences": [
          "The public search response is { took, hits: { total, hits: [ { _index, _id, _source } ] } }. This mock returns that shape.",
          "total is a number on clusters before 7.0 and an object after. This mock uses the 7+ object. Shards, timed_out, and aggregations are omitted.",
          "Basic auth is checked with the dummy elastic user. API keys and the Elastic Cloud host are not modeled."
        ]
      }
    },
    "operations": [
      {
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "offset",
          "limitParam": "size",
          "offsetParam": "from",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 10,
          "maxLimit": 100
        },
        "id": "search",
        "method": "POST",
        "pathTemplate": "/{index}/_search",
        "summary": "Search an index",
        "status": 200,
        "list": false,
        "envelope": {
          "type": "object"
        },
        "record": {
          "name": "search",
          "kind": "object",
          "children": [
            {
              "name": "took",
              "kind": "integer"
            },
            {
              "name": "hits",
              "kind": "object",
              "children": [
                {
                  "name": "total",
                  "kind": "object",
                  "children": [
                    {
                      "name": "value",
                      "kind": "integer"
                    },
                    {
                      "name": "relation",
                      "kind": "const",
                      "constValue": "eq"
                    }
                  ]
                },
                {
                  "name": "hits",
                  "kind": "array",
                  "pageItems": true,
                  "item": {
                    "name": "hit",
                    "kind": "object",
                    "children": [
                      {
                        "name": "_index",
                        "kind": "string",
                        "example": "logs"
                      },
                      {
                        "name": "_id",
                        "kind": "id"
                      },
                      {
                        "name": "_source",
                        "kind": "object",
                        "children": [
                          {
                            "name": "message",
                            "kind": "string",
                            "example": "Failed password for lab-user"
                          },
                          {
                            "name": "@timestamp",
                            "kind": "timestamp",
                            "format": "iso"
                          },
                          {
                            "name": "host",
                            "kind": "string",
                            "example": "lab-workstation"
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      }
    ],
    "chaos": {
      "enabled": false,
      "seed": "elasticsearch-elasticsearch-v2",
      "mode": "probability",
      "probability": 0.25,
      "everyNth": 5,
      "duplicateRecords": false,
      "missingFields": false,
      "mixedTimestamps": false,
      "outOfOrder": false,
      "wrongTypes": false,
      "truncatedJson": false,
      "slowDrip": false,
      "partial": false,
      "malformedJson": false,
      "wrongContentType": false,
      "randomErrors": false,
      "latency": false,
      "paginationGlitch": "none",
      "malformedXml": false,
      "wrongNamespace": false,
      "soapFault": false,
      "authExpired": false,
      "authDenied": false,
      "authTokenFailure": false,
      "authClockSkew": false
    },
    "totalRecords": 500,
    "auth": {
      "mode": "basic",
      "basic": {
        "username": "elastic",
        "password": "dummy-not-a-real-password"
      }
    }
  }
}
