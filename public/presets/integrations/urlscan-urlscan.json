  "spec": {
    "version": 1,
    "source": {
      "kind": "preset",
      "id": "urlscan-urlscan",
      "name": "urlscan.io",
      "fidelity": "verified",
      "attribution": "Public API reference or demisto/content test fixture (MIT).",
      "sourceUrl": "https://urlscan.io/docs/api/",
      "notes": [
        "GET /api/v1/search returns { results }. Each hit keeps task.uuid and page.url, page.ip, and page.server.",
        "POST /api/v1/scan and the result poll are not modeled.",
        "API-Key is required for search on the live service."
      ],
      "verification": {
        "status": "verified",
        "docUrl": "https://urlscan.io/docs/api/",
        "checkedAt": "2026-11-10",
        "differences": [
          "GET /api/v1/search returns { results }. Each hit keeps task.uuid and page.url, page.ip, and page.server.",
          "POST /api/v1/scan and the result poll are not modeled.",
          "API-Key is required for search on the live service."
        ]
      }
    },
    "operations": [
      {
        "id": "search",
        "method": "GET",
        "pathTemplate": "/api/v1/search",
        "summary": "Search scans",
        "status": 200,
        "list": true,
        "envelope": {
          "type": "wrapped",
          "arrayKey": "results"
        },
        "record": {
          "name": "result",
          "kind": "object",
          "children": [
            {
              "name": "task",
              "kind": "object",
              "children": [
                {
                  "name": "uuid",
                  "kind": "uuid"
                },
                {
                  "name": "time",
                  "kind": "timestamp"
                }
              ]
            },
            {
              "name": "page",
              "kind": "object",
              "children": [
                {
                  "name": "url",
                  "kind": "string",
                  "example": "https://example.com/"
                },
                {
                  "name": "ip",
                  "kind": "ip"
                },
                {
                  "name": "server",
                  "kind": "string",
                  "example": "nginx"
                }
              ]
            }
          ]
        },
        "headers": {},
        "contentType": "application/json; charset=utf-8",
        "pagination": {
          "style": "offset",
          "limitParam": "size",
          "offsetParam": "offset",
          "pageParam": "page",
          "cursorParam": "cursor",
          "defaultLimit": 20,
          "maxLimit": 500
        }
      }
    ],
    "chaos": {
      "enabled": false,
      "seed": "urlscan-urlscan",
      "mode": "probability",
      "probability": 0.25,
      "everyNth": 5,
      "duplicateRecords": false,
      "missingFields": false,
      "mixedTimestamps": false,
      "outOfOrder": false,
      "wrongTypes": false,
      "truncatedJson": false,
      "slowDrip": false,
      "partial": false,
      "malformedJson": false,
      "wrongContentType": false,
      "randomErrors": false,
      "latency": false,
      "paginationGlitch": "none",
      "malformedXml": false,
      "wrongNamespace": false,
      "soapFault": false,
      "authExpired": false,
      "authDenied": false,
      "authTokenFailure": false,
      "authClockSkew": false,
      "graphqlErrors": false
    },
    "totalRecords": 20,
    "auth": {
      "mode": "api-key",
      "apiKey": {
        "in": "header",
        "name": "API-Key",
        "value": "dummy-key"
      }
    }
  }
